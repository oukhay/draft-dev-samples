# Artifacts generated by following the tutorials in this repo.
# Never commit these: the SSH key is a private key, and the images
# and snapshot files are ~1 GB each.

# SSH keys generated in Step 1 of the Firecracker tutorial
*.id_rsa

# Guest kernel, root filesystem images, and Firecracker downloads
vmlinux*
*.ext4
*.squashfs*
firecracker*.tgz
release-*/

# Extracted root filesystem and snapshot output
squashfs-root/
snapshot/
*.mem
*.state

# OS noise
.DS_Store
